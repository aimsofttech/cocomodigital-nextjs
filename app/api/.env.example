# Server
PORT=5000
NODE_ENV=development

# MongoDB
MONGO_URI=mongodb://localhost:27017/cocoma_digital_db

# JWT
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=7d

# AWS S3
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_DEFAULT_REGION=eu-north-1
AWS_BUCKET=cocomadigitalmediabucket
AWS_URL=https://cocomadigitalmediabucket.s3.eu-north-1.amazonaws.com
AWS_USE_PATH_STYLE_ENDPOINT=false

# Admin Default Credentials (for seeder)
ADMIN_EMAIL=admin@cocoma.com
ADMIN_PASSWORD=Admin@123456

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ── Email (booking notifications) ──────────────────────────────
# SMTP credentials for outgoing mail. If SMTP_USER/SMTP_PASS are empty, email
# is disabled (bookings still succeed; a warning is logged at boot).
# Gmail: use an App Password (Google account → Security → App passwords).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=anshukumar2708@gmail.com
SMTP_PASS=
MAIL_FROM=Cocoma Digital <anshukumar2708@gmail.com>
MAIL_BRAND=Cocoma Digital
# Booking alerts go to the website owner (Anil):
OWNER_EMAIL=anshukumar2708@gmail.com
# Admin panel base URL — Confirm/Reject/Reschedule buttons in the owner's
# meeting-request email deep-link here (include the /admin base path):
ADMIN_PANEL_URL=https://cocomadigital.com/admin

# ── Google Meet / Calendar (booking Meet links) ────────────────
# When set, each booking creates a Google Calendar event with a Google Meet
# link, included in BOTH the owner and visitor emails. If unset, bookings and
# emails still work — just without a Meet link.
# Setup (one-time): Google Cloud Console → enable "Google Calendar API" →
# create an OAuth 2.0 Client ID (Web app) → run the consent flow with scope
# https://www.googleapis.com/auth/calendar.events to obtain a refresh token.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# Only needed while running the one-time consent flow:
GOOGLE_REDIRECT_URI=http://localhost:5000/api/google/oauth/callback
# Calendar to create events on (the host account's calendar):
GOOGLE_CALENDAR_ID=primary
# Host added as an attendee on the event (defaults to OWNER_EMAIL):
MEETING_HOST_EMAIL=anshukumar2708@gmail.com
# Meeting length + fallback timezone for slots without one:
MEETING_DURATION_MIN=15
BOOKING_TIMEZONE=Asia/Kolkata
