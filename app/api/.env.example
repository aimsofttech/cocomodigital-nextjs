# Server
PORT=5000
NODE_ENV=development

# MongoDB
MONGO_URI=mongodb://localhost:27017/cocoma_digital_db

# JWT
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=7d

# AWS S3
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_DEFAULT_REGION=eu-north-1
AWS_BUCKET=cocomadigitalmediabucket
AWS_URL=https://cocomadigitalmediabucket.s3.eu-north-1.amazonaws.com
AWS_USE_PATH_STYLE_ENDPOINT=false

# Admin Default Credentials (for seeder)
ADMIN_EMAIL=admin@cocoma.com
ADMIN_PASSWORD=Admin@123456

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5174

# ── Email (booking notifications) ──────────────────────────────
# SMTP credentials for outgoing mail. If SMTP_USER/SMTP_PASS are empty, email
# is disabled (bookings still succeed; a warning is logged at boot).
# Gmail: use an App Password (Google account → Security → App passwords).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=anshukumar2708@gmail.com
SMTP_PASS=
MAIL_FROM=Cocoma Digital <anshukumar2708@gmail.com>
MAIL_BRAND=Cocoma Digital
# Booking alerts go to the website owner (Anil):
OWNER_EMAIL=anshukumar2708@gmail.com
# Owner display name — used in assignment emails ("<OWNER_NAME> has assigned you a meeting"):
OWNER_NAME=Anil
# Admin panel base URL — Confirm/Reject/Reschedule buttons in the owner's
# meeting-request email deep-link here (include the /admin base path):
ADMIN_PANEL_URL=https://cocomadigital.com/admin

# ── Google Meet / Calendar (booking Meet links) ────────────────
# When set, each booking creates a Google Calendar event with a Google Meet
# link, included in BOTH the owner and visitor emails. If unset, bookings and
# emails still work — just without a Meet link.
# Setup (one-time): Google Cloud Console → enable "Google Calendar API" →
# create an OAuth 2.0 Client ID (Web app) → run the consent flow with scope
# https://www.googleapis.com/auth/calendar.events to obtain a refresh token.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# Only needed while running the one-time consent flow:
GOOGLE_REDIRECT_URI=http://localhost:5000/api/google/oauth/callback
# Calendar to create events on (the host account's calendar):
GOOGLE_CALENDAR_ID=primary
# Host added as an attendee on the event (defaults to OWNER_EMAIL):
MEETING_HOST_EMAIL=anshukumar2708@gmail.com
# Meeting length + fallback timezone for slots without one:
MEETING_DURATION_MIN=15
BOOKING_TIMEZONE=Asia/Kolkata

# ── Twilio (SMS + click-to-call + WhatsApp) ────────────────────
# Console → Account Dashboard for the SID + auth token. Leave blank to disable;
# without these, SMS sends fail cleanly and calls fall back to free tel: links.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Twilio numbers in E.164 form, e.g. +15551234567 (SMS- / voice-capable).
TWILIO_SMS_FROM=
TWILIO_VOICE_FROM=
TWILIO_PHONE_NUMBER=
# WhatsApp sender — keep the "whatsapp:" prefix. Trial accounts use the shared
# sandbox below; recipients must first send "join <your-code>" to +14155238886.
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# Fallback Content template SID (Console → Messaging → Content Template Builder).
# Required to message anyone outside the 24-hour customer-service window. Prefer
# setting a SID per template in the CRM (Templates → Twilio Content SID), which
# overrides this.
#
# For production this must be a template YOU created and had approved.
#
# For sandbox testing you can borrow one of Twilio's quick-start templates from
# Console → Messaging → Try it out → Send a WhatsApp message, e.g.
# HXb5b62575e6e4ff6129ad7c8efe1f983e ("Appointment Reminders"). Those are owned
# by Twilio: they return 20404 from the Content API and never appear in your own
# template list, but the sandbox sender may send them. A production sender may
# not (63024), so swap it before you leave the sandbox.
# Verify with: node scripts/check-whatsapp.js
TWILIO_WHATSAPP_CONTENT_SID=
# Values for the above template's positional placeholders, as JSON keyed by
# position. Required whenever that template declares any — Twilio rejects the
# send with 63021 when they are missing or do not match the approved template.
# Values support CRM placeholders ({{name}}, {{first_name}}, {{agent_name}},
# {{company}}, {{service}}), rendered per recipient.
#   "Appointment Reminders" takes {{1}} date and {{2}} time:
#   TWILIO_WHATSAPP_CONTENT_VARS={"1":"12/1","2":"3pm"}
TWILIO_WHATSAPP_CONTENT_VARS=
# Default recipient for scripts/check-whatsapp.js and scripts/dryrun-whatsapp.js.
# On the sandbox this number must have sent "join <code>" to +1 415 523 8886.
WHATSAPP_TEST_TO=

# Public HTTPS base URL of this API — needed for Twilio delivery-status
# callbacks, inbound webhooks, and the TwiML every outbound call fetches.
# Leave blank and messages stall at 'sent', no replies reach the inbox, and
# calls ring and then go silent.
#
# Origin ONLY — no trailing slash, no path. The path comes from
# CRM_PUBLIC_PATH below, and the two are joined to build every callback URL.
#
# This value is environment-specific; there is no single URL that works for
# both. Set it per deployment:
#
#   Local dev   a tunnel to port 5000, e.g.
#                 cloudflared tunnel --url http://localhost:5000
#                 ngrok http 5000
#               A free quick-tunnel URL CHANGES every restart, so this must be
#               updated (and the API restarted, and the Twilio Console webhooks
#               re-pointed) each time. An ngrok reserved domain avoids that.
#
#   Production  the real HTTPS origin the API answers on, e.g.
#                 API_PUBLIC_URL=https://cocomadigital.com
#                 CRM_PUBLIC_PATH=/api/crm
#               (on that host the proxy forwards /api/* to this app, so the
#               local /crm/api mount is NOT publicly reachable — see
#               src/crm/publicUrl.js.)
#
# Verify with: node scripts/check-twilio.js
API_PUBLIC_URL=

# Public path prefix the CRM API answers on. Defaults to /crm/api, which is also
# where it is mounted locally. Override when your reverse proxy forwards some
# other prefix to this app — the CRM is then mounted at both, and every callback
# URL is built from this one. The proxy must pass the path through unchanged;
# stripping the prefix breaks Twilio signature validation.
CRM_PUBLIC_PATH=/crm/api
# Webhook signature validation is enabled automatically whenever
# TWILIO_AUTH_TOKEN is set. Set to false only to bypass it in local testing.
TWILIO_VALIDATE_WEBHOOKS=true

# ── Twilio Voice ───────────────────────────────────────────────
# Preferred REST credentials. An API Key can be revoked on its own; the account
# auth token cannot, because it is also what verifies every webhook signature.
# Console → Account → API keys & tokens → Create API key (Standard).
# Leave blank to fall back to TWILIO_AUTH_TOKEN.
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=

# Record calls. Two-party-consent jurisdictions (and Indian TRAI guidance)
# require the announcement below to be played before recording starts.
TWILIO_RECORD_CALLS=true
TWILIO_RECORDING_ANNOUNCEMENT=This call may be recorded for quality and training purposes.

# Answering-machine detection for automated calls. Adds 2-6s of ring time and
# costs extra per call, but without it a robocall talks over the voicemail beep.
TWILIO_MACHINE_DETECTION=true

# Seconds to ring before giving up, and a hard ceiling on call length so a
# forgotten open line cannot bill for hours.
TWILIO_CALL_TIMEOUT_SEC=30
# Hard stop on a runaway call, in seconds. Twilio caps this PER ACCOUNT, not at
# a fixed maximum: a trial account rejects anything above 899 with error 13216
# and refuses to place the call. 899 is safe on trial and paid alike; raise it
# once you are on a paid plan if you need longer calls.
TWILIO_MAX_CALL_SEC=899

# Automatic retry of unanswered/busy/failed outbound calls. Permanent failures
# (invalid number, geo-blocked, unverified on a trial account) are never retried.
TWILIO_MAX_CALL_ATTEMPTS=3
TWILIO_RETRY_DELAY_MIN=30

# Ceiling on simultaneous live calls per campaign. New Twilio accounts are
# limited to 1 call per second; raise only after Twilio lifts your limit.
TWILIO_MAX_CONCURRENCY=5
CRM_MAX_CAMPAIGN_TARGETS=2000

# Spoken to inbound callers before the agent's phone rings.
TWILIO_INBOUND_GREETING=
CRM_BRAND_NAME=Cocoma Digital
