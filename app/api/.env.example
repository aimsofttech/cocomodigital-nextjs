# Server
PORT=5000
NODE_ENV=development

# MongoDB
MONGO_URI=mongodb://localhost:27017/cocoma_digital_db

# JWT
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=7d

# AWS S3
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_DEFAULT_REGION=eu-north-1
AWS_BUCKET=cocomadigitalmediabucket
AWS_URL=https://cocomadigitalmediabucket.s3.eu-north-1.amazonaws.com
AWS_USE_PATH_STYLE_ENDPOINT=false

# Admin Default Credentials (for seeder)
ADMIN_EMAIL=admin@cocoma.com
ADMIN_PASSWORD=Admin@123456

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
