  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health — with key (200)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"body is { ok: true }\", () => pm.expect(pm.response.json()).to.eql({ ok: true }));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "X-Agent-Key",
                "value": "{{agentKey}}",
                "type": "text"
              },
              {
                "key": "X-Conversation-Id",
                "value": "postman-test-conversation",
                "type": "text",
                "description": "Optional. Echoed into the [wa-agent] log line only."
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/wa-agent/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "wa-agent",
                "health"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Health — without key (401)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 401\", () => pm.response.to.have.status(401));",
                  "pm.test(\"bare unauthorized\", () => pm.expect(pm.response.json().reason).to.eql(\"unauthorized\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/wa-agent/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "wa-agent",
                "health"
              ]
            }
          },
          "response": []
        },
        {
