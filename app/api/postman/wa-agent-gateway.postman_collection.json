{
  "info": {
    "name": "WhatsApp Agent Gateway (cocomadigital.com)",
    "description": "Requests for /api/wa-agent. Set baseUrl and agentKey in the \"wa-agent local\" environment. The key is never stored here (REPLACE_ME).",
