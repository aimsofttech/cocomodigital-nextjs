# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage

# production
/build
/.next
*.tsbuildinfo

# misc
.DS_Store
# Local env files — never commit. .env.local is the CRA
# convention for local-only secrets. Bare .env is added too as
# belt-and-suspenders against accidental misnaming when secrets
# (AWS keys, API tokens, etc.) get dropped into the repo.
npm-debug.log*
yarn-debug.log*
yarn-error.log*
next-dev.log
next-dev.err.log

.claude/
