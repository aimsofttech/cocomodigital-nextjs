# ============================================================
#   Cocoma Next.js — environment variables
# ============================================================
#
# Copy this file to .env.local for local dev:
#   cp .env.example .env.local
#
# The web app is a pure frontend: all content comes from the
# standalone Express + MongoDB API (cocoma-admin-api). There is no
# database, CMS, or server secret in this app.
# ============================================================

# Public site URL — used for OG tags, canonical URLs, redirects.
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Standalone content API base URL (Express + MongoDB). No trailing slash.
NEXT_PUBLIC_API_URL=http://localhost:5000/api
