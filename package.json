{
  "name": "cocoma-admin-api",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "app/api",
    "app/admin",
    "app/crm"
  ],
  "scripts": {
    "predev": "node scripts/free-ports.js",
    "dev": "concurrently -n \"API,ADMIN,CRM,WEB\" -c \"bgBlue.bold,bgMagenta.bold,bgCyan.bold,bgGreen.bold\" \"npm run dev -w @cocoma/api\" \"npm run dev -w @cocoma/admin\" \"npm run dev -w @cocoma/crm\" \"npm run dev:web\"",
    "dev:api": "npm run dev -w @cocoma/api",
    "dev:admin": "npm run dev -w @cocoma/admin",
    "dev:crm": "npm run dev -w @cocoma/crm",
    "build:crm": "npm run build -w @cocoma/crm",
    "dev:web": "node scripts/dev-web.js",
    "build": "npm run build -w @cocoma/admin",
    "start": "npm run start -w @cocoma/api",
    "seed": "npm run seed -w @cocoma/api",
    "install:all": "npm install && npm install --prefix app/web"
  },
  "devDependencies": {
    "concurrently": "^9.0.0",
    "wait-on": "^8.0.5"
  }
}
